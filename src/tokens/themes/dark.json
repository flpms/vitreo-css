{
  "$description": "Tema escuro — nave à noite: fundo grafite, vidros acesos como joias.",
  "$type": "color",
  "canvas": {
    "$description": "Camada L0 — fundo da página.",
    "bg": {
      "$value": "{color.lead.950}"
    },
    "fg": {
      "$value": "{color.glass.100}"
    },
    "muted": {
      "$value": "{color.lead.300}"
    }
  },
  "lead": {
    "$value": "{color.lead.700}",
    "$description": "Chumbo: contorno fino em grafite. Decorativo — o contraste exigido fica com field.edge, foco e elevação."
  },
  "shade": {
    "$value": "{color.lead.950}",
    "$description": "Base escura da espessura da tecla: a profundidade é a cor do botão misturada com ela."
  },
  "focus": {
    "outer": {
      "$value": "{color.amber.300}"
    },
    "inner": {
      "$value": "{color.lead.950}"
    }
  },
  "light": {
    "$description": "Luz atrás do vidro — as primárias do Mondrian desfocadas atrás do grid. Os vidros filtram essa luz.",
    "red": {
      "$value": "{color.mondrian.red}",
      "$extensions": {
        "vitreo": {
          "alpha": 0.24
        }
      }
    },
    "yellow": {
      "$value": "{color.mondrian.yellow}",
      "$extensions": {
        "vitreo": {
          "alpha": 0.24
        }
      }
    },
    "blue": {
      "$value": "{color.mondrian.blue}",
      "$extensions": {
        "vitreo": {
          "alpha": 0.24
        }
      }
    }
  },
