{
  "$description": "Tema claro — vitral à luz do dia: pergaminho, chumbo preto e vidros saturados.",
  "$type": "color",
  "canvas": {
    "$description": "Camada L0 — fundo da página.",
    "bg": { "$value": "{color.paper.100}" },
    "fg": { "$value": "{color.ink.900}" },
    "muted": { "$value": "{color.ink.500}" }
  },
  "lead": { "$value": "{color.ink.900}", "$description": "Chumbo: contorno escuro de toda peça." },
  "glint": { "$value": "{color.paper.50}", "$description": "Brilho do vidro: aparece só no degrau de elevação (direita e embaixo) dos controles no hover, junto do chumbo." },
  "shade": { "$value": "{color.ink.900}", "$description": "Sombra do degrau de elevação. Com o brilho forma um par claro/escuro que aparece sobre qualquer camada." },
  "focus": {
    "outer": { "$value": "{color.ink.900}" },
    "inner": { "$value": "{color.yellow.300}" }
  },
  "light": {
    "$description": "Luz atrás do vidro — blocos Mondrian decorativos atrás do grid (ideia 2).",
    "red": { "$value": "{color.red.200}", "$extensions": { "vitreo": { "alpha": 0.9 } } },
    "blue": { "$value": "{color.blue.200}", "$extensions": { "vitreo": { "alpha": 0.9 } } },
    "yellow": { "$value": "{color.yellow.200}", "$extensions": { "vitreo": { "alpha": 0.9 } } }
  },
  "surface": {
    "$description": "Camada L1 — vidros translúcidos (cards, alertas).",
    "neutral": {
      "bg": { "$value": "{color.paper.50}", "$extensions": { "vitreo": { "alpha": 0.72 } } },
      "fg": { "$value": "{color.ink.900}" },
      "muted": { "$value": "{color.ink.500}" }
    },
    "red": {
      "bg": { "$value": "{color.red.800}", "$extensions": { "vitreo": { "alpha": 0.92 } } },
      "fg": { "$value": "{color.white}" },
      "muted": { "$value": "{color.red.100}" }
    },
    "blue": {
      "bg": { "$value": "{color.blue.800}", "$extensions": { "vitreo": { "alpha": 0.92 } } },
      "fg": { "$value": "{color.white}" },
      "muted": { "$value": "{color.blue.100}" }
    },
    "yellow": {
      "bg": { "$value": "{color.yellow.400}", "$extensions": { "vitreo": { "alpha": 0.92 } } },
      "fg": { "$value": "{color.ink.900}" },
      "muted": { "$value": "{color.ink.700}" }
    },
    "emerald": {
      "bg": { "$value": "{color.emerald.800}", "$extensions": { "vitreo": { "alpha": 0.95 } } },
      "fg": { "$value": "{color.white}" },
      "muted": { "$value": "{color.emerald.100}" }
    }
  },
  "control": {
    "$description": "Camada L2 — preenchimentos sólidos de botões.",
    "primary": {
      "bg": { "$value": "{color.red.700}" },
      "bg-hover": { "$value": "{color.red.800}" },
      "fg": { "$value": "{color.white}" }
    },
    "secondary": {
      "bg": { "$value": "{color.blue.700}" },
      "bg-hover": { "$value": "{color.blue.800}" },
      "fg": { "$value": "{color.white}" }
    },
    "accent": {
      "bg": { "$value": "{color.yellow.400}" },
      "bg-hover": { "$value": "{color.yellow.500}" },
      "fg": { "$value": "{color.ink.900}" }
    }
  },
  "field": {
    "$description": "Camada L2 — campos de texto.",
    "bg": { "$value": "{color.paper.50}" },
    "fg": { "$value": "{color.ink.900}" },
    "placeholder": { "$value": "{color.ink.500}" },
    "edge": { "$value": "{color.ink.900}", "$description": "Contorno do campo: ≥ 3:1 contra qualquer camada (WCAG 1.4.11)." },
    "invalid": { "$value": "{color.red.700}" }
  },
  "sheen": {
    "$description": "Reflexo diagonal do vidro, aplicado sobre superfícies e botões.",
    "$value": "{color.white}",
    "$extensions": { "vitreo": { "alpha": 0.1 } }
  }
}
