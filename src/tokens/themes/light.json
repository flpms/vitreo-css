{
  "$description": "Tema claro — vidro antigo à luz do dia: fundo de vidro claro, chumbo grafite, vidros tingidos.",
  "$type": "color",
  "canvas": {
    "$description": "Camada L0 — fundo da página.",
    "bg": {
      "$value": "{color.glass.50}"
    },
    "fg": {
      "$value": "{color.lead.950}"
    },
    "muted": {
      "$value": "{color.lead.700}"
    }
  },
  "lead": {
    "$value": "{color.lead.800}",
    "$description": "Chumbo: contorno fino em grafite. Decorativo — o contraste exigido fica com field.edge, foco e elevação."
  },
  "glint": {
    "$value": "{color.white}",
    "$description": "Brilho do vidro: só no degrau de elevação (direita e embaixo) dos controles no hover."
  },
  "shade": {
    "$value": "{color.lead.950}",
    "$description": "Sombra do degrau de elevação. Com o brilho forma um par claro/escuro visível sobre qualquer camada."
  },
  "focus": {
    "outer": {
      "$value": "{color.lead.950}"
    },
    "inner": {
      "$value": "{color.amber.200}"
    }
  },
  "light": {
    "$description": "Luz atrás do vidro — blocos desfocados atrás do grid (ideia 2).",
