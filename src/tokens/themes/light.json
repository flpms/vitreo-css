    "edge": {
      "$value": "{color.lead.500}",
      "$description": "Contorno do campo: ≥ 3:1 contra qualquer camada (WCAG 1.4.11)."
    }
  },
  "data": {
    "$description": "Paleta categórica para gráficos: ≥ 3:1 contra o fundo e o vidro neutro (WCAG 1.4.11).",
    "1": {
      "$value": "{color.cobalt.500}"
    },
    "2": {
      "$value": "{color.ruby.500}"
    },
    "3": {
      "$value": "{color.amber.500}"
    },
    "4": {
      "$value": "{color.verdigris.500}"
    },
    "5": {
      "$value": "{color.amethyst.500}"
    },
